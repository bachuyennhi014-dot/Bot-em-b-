# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
# Discord Bot Token from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=""

# Discord Application / Client ID
CLIENT_ID=""

# Unique Bot Owner / Admin User ID (Hardcoded check: 1402913586853974156)
BOT_ADMIN_ID="1402913586853974156"

# Command Prefix
PREFIX="*P"

# Database Configuration:
# Leave DATABASE_URL empty to use SQLite (auto-created in data/bot.sqlite)
# Or set PostgreSQL URL: postgresql://username:password@localhost:5432/bot_db
DATABASE_URL=""

# House (Private Channel) Price in kc (Default: 200000)
DEFAULT_HOUSE_PRICE="200000"

